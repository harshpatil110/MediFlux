# MediFlux Environment Configuration Template
# All secrets must use safe placeholders. Never commit live production credentials.

# Supabase Credentials & Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_KEY=your-anon-key-placeholder
SUPABASE_JWT_SECRET=your-jwt-secret-placeholder-minimum-32-chars

# LLM Provider Credentials
NVIDIA_API_KEY=nvapi-placeholder-key-do-not-commit
OPENROUTER_API_KEY=sk-or-v1-placeholder-key-do-not-commit
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embeddings & Vector Search
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# LLM Replay & Cache Configuration
LLM_CACHE_MODE=off
LLM_CACHE_PATH=fixtures/demo_cache/llm_replay_cache.json
LLM_CACHE_DB_PATH=llm_cache.db

# Application Operational Modes
DEMO_MODE=false
CASCADE_MODE=per_event
CASCADE_MICRO_BATCH_WINDOW_SECONDS=5
CASCADE_MAX_CONCURRENCY=2
REG_AUTO_DEPLOY=false

# MCP Server Configuration
MCP_ALLOW_DECIDE_APPROVAL=true

# Agent Configuration
AGENT_MODELS_CONFIG_PATH=config/agent_models.yaml
